# Copy to .env.local and fill in from the Supabase project dashboard.
# Never commit the filled-in file — .env* is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, used from Server Actions / route handlers. Never expose
# to the client bundle (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

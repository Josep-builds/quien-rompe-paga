# Copy to .env.local and fill in from the Supabase project dashboard.
# Never commit the filled-in file — .env* is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, used from API routes / server components. Never expose
# to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
